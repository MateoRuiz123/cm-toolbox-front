# El navegador llama /migracion/diagnostico y /migracion/guia (same-origin).
# Vite (pnpm dev) y nginx (contenedor) lo enrutan aquí. Prefijo URI del API,
# sin /migracion al final. No uses VITE_: esa variable entra al bundle.
# DIAGNOSTICO_API_UPSTREAM=http://localhost:8080/cm-api-internos

# Opcional. El API de /migracion/guia ignora este campo; solo se envía para emular Pub/Sub.
# VITE_PUBSUB_SUBSCRIPTION=projects/cm-api-guias-test/subscriptions/fletes-plenos-sub

# Origen de Keycloak que el navegador sí debe conocer (redirect OIDC).
# KEYCLOAK_UPSTREAM=https://auth.coordinadora.com

# Autenticación corporativa Keycloak (Google IdP)
# VITE_KEYCLOAK_URL=https://auth.coordinadora.com
# VITE_KEYCLOAK_REALM=coordinadora
# VITE_KEYCLOAK_CLIENT_ID=cm-diagnostico-despachos-front

# En pnpm dev el login se salta. Para probar Keycloak en local:
# VITE_AUTH_FORCE_KEYCLOAK=true

# Visor de Logs GKE: el navegador solo ve /logs-api (same-origin). Vite (dev) y
# nginx (prod) lo enrutan a cm-logs-ms. Solo esquema://host[:puerto], sin path.
# El origen del front debe estar en CORS_ORIGINS de cm-logs-ms (valida el WS).
# LOGS_API_UPSTREAM=http://localhost:8081
