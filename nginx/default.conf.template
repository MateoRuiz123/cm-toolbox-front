map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${KEYCLOAK_UPSTREAM}; font-src 'self';" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location = /diagnostico-api/health {
        access_log off;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $diagnostico_api "${DIAGNOSTICO_API_UPSTREAM}";
        proxy_pass $diagnostico_api/health;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /migracion/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $diagnostico_api "${DIAGNOSTICO_API_UPSTREAM}";
        # Con variables en proxy_pass nginx no reescribe el path: hay que pasar
        # $request_uri completo o se pierde el segmento final (/diagnostico).
        proxy_pass $diagnostico_api$request_uri;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Visor de logs GKE: REST + WebSocket hacia cm-logs-ms sin exponer su URL.
    location /logs-api/ {
        set $logs_api "${LOGS_API_UPSTREAM}";
        if ($logs_api = "") {
            return 503;
        }
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        rewrite ^/logs-api/(.*)$ /$1 break;
        proxy_pass $logs_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Control de acceso RBAC y estado de aplicaciones: REST hacia cm-toolbox-access-ms.
    location /access-api/ {
        set $access_api "${ACCESS_API_UPSTREAM}";
        if ($access_api = "") {
            return 503;
        }
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        rewrite ^/access-api/(.*)$ /$1 break;
        proxy_pass $access_api;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Documentación OpenAPI: REST hacia cm-docs-ms.
    location /docs-api/ {
        set $docs_api "${DOCS_API_UPSTREAM}";
        if ($docs_api = "") {
            return 503;
        }
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        rewrite ^/docs-api/(.*)$ /$1 break;
        proxy_pass $docs_api;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 2m;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Evita que rutas .webp inexistentes de ambientación reciban index.html vía fallback SPA.
    location /hub-ambient/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
