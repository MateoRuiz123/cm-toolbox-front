{
  "name": "cm-toolbox-front",
  "description": "Portal y Hub de herramientas de apoyo y diagnóstico",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "oxlint src test",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "analyze:bundle": "pnpm build && node scripts/report-bundle-size.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@itcoordinadora/cm-sigoo-temp-ui": "^1.0.14",
    "clsx": "^2.1.1",
    "keycloak-js": "26.1.5",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "^30.1.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
