{
  "name": "cm-toolbox-front",
  "description": "Portal y Hub de herramientas de apoyo y diagnóstico",
  "private": true,
  "version": "1.20.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/dev-with-backends.mjs",
    "dev:front": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "oxlint src test",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "analyze:bundle": "pnpm build && node scripts/report-bundle-size.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@itcoordinadora/cm-sigoo-temp-ui": "^1.0.14",
    "clsx": "^2.1.1",
    "keycloak-js": "26.2.4",
    "lucide-react": "^1.77.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "vite@>=6 <7": "6.4.4",
      "vite@>=8 <9": "8.3.5"
    }
  }
}
